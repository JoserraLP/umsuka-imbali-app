# =========================================================
# UMSUKA IMBALI APP — Environment Variables
# Copy this file to .env.local for local development.
# Never commit .env.local or real secrets to the repository.
# =========================================================

# Supabase project URL and public anon key (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key — SERVER ONLY. Never expose to the client.
# Used exclusively by src/lib/supabase/admin.ts inside server-only code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL, used to build OAuth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
